{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen Setup",
  "version": "1.1.0",
  "identifier": "com.reiux.lumen.installer",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen Setup",
        "width": 620,
        "height": 420,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "transparent": true,
        "dataDirectory": "installer_cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
