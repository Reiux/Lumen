{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "2.0.1",
  "identifier": "com.reiux.lumen",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen v2.0.1",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#121316",
        "dataDirectory": "webview_cache"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.googleapis.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/background.png",
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 130, "y": 190 },
        "applicationFolderPosition": { "x": 410, "y": 190 }
      }
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
