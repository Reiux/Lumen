{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "1.1.0",
  "identifier": "com.reiux.lumen",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen v1.1.0",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/background.png",
        "appPosition": { "x": 130, "y": 190 },
        "applicationFolderPosition": { "x": 410, "y": 190 }
      }
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
